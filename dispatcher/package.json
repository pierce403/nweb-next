{
  "name": "nweb-dispatcher",
  "version": "0.1.0",
  "description": "Open target-spec dispatcher for nweb collectors",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
