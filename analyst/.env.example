# Database Configuration
# Local read/write development database:
POSTGRES_URL=postgresql://nweb:nweb@localhost:5432/nweb
#
# Vercel/public deployment should use the read-only Analyst role:
# POSTGRES_URL=postgresql://nweb_analyst_ro:<password>@50.126.86.253:5432/nweb?sslmode=require
# POSTGRES_CA_CERT can be set when certificate verification is required.
# Public submit is disabled unless explicitly enabled.
ENABLE_PUBLIC_SUBMIT=false

# Next.js Configuration
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000

